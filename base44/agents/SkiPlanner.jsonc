  "whatsapp_greeting": "\u05e9\u05dc\u05d5\u05dd! \u05d0\u05e0\u05d9 \u05e1\u05d5\u05db\u05df \u05d4-SkiPlanner \u05d4\u05d0\u05d9\u05e9\u05d9 \u05e9\u05dc\u05db\u05dd. \u05d0\u05d9\u05da \u05d0\u05d5\u05db\u05dc \u05dc\u05e2\u05d6\u05d5\u05e8 \u05dc\u05db\u05dd \u05dc\u05ea\u05db\u05e0\u05df \u05d0\u05ea \u05d7\u05d5\u05e4\u05e9\u05ea \u05d4\u05e1\u05e7\u05d9 \u05e9\u05dc\u05db\u05dd? ",
