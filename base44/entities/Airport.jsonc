{
  "name": "Airport",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05e9\u05d3\u05d4 \u05d4\u05ea\u05e2\u05d5\u05e4\u05d4"
    },
    "code": {
      "type": "string",
      "description": "\u05e7\u05d5\u05d3 IATA"
    },
    "city": {
      "type": "string",
      "description": "\u05e2\u05d9\u05e8"
    },
    "country": {
      "type": "string",
      "description": "\u05de\u05d3\u05d9\u05e0\u05d4"
    },
    "serves_destinations": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u05d9\u05e2\u05d3\u05d9 \u05e1\u05e7\u05d9 \u05e9\u05de\u05e9\u05e8\u05ea (\u05e9\u05de\u05d5\u05ea \u05d4\u05d9\u05e2\u05d3\u05d9\u05dd)"
    },
    "description": {
      "type": "string",
      "description": "\u05ea\u05d9\u05d0\u05d5\u05e8 (\u05e2\u05d3 1000 \u05ea\u05d5\u05d5\u05d9\u05dd)",
      "maxLength": 1000
    }
  },
  "required": [
    "name",
    "code",
    "city",
    "country"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}