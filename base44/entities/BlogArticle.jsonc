{
  "name": "BlogArticle",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "\u05db\u05d5\u05ea\u05e8\u05ea \u05d4\u05de\u05d0\u05de\u05e8"
    },
    "slug": {
      "type": "string",
      "description": "\u05db\u05ea\u05d5\u05d1\u05ea URL \u05d9\u05d3\u05d9\u05d3\u05d5\u05ea\u05d9\u05ea (\u05d1\u05d0\u05e0\u05d2\u05dc\u05d9\u05ea, \u05d7\u05d5\u05d1\u05d4 \u05dc\u05db\u05dc \u05de\u05d0\u05de\u05e8 \u05d7\u05d3\u05e9)"
    },
    "excerpt": {
      "type": "string",
      "description": "\u05ea\u05e7\u05e6\u05d9\u05e8 \u05e7\u05e6\u05e8 \u05e9\u05d9\u05d5\u05e4\u05d9\u05e2 \u05d1\u05db\u05e8\u05d8\u05d9\u05e1 \u05d4\u05de\u05d0\u05de\u05e8"
    },
    "content": {
      "type": "string",
      "description": "\u05ea\u05d5\u05db\u05df \u05d4\u05de\u05d0\u05de\u05e8 \u05d4\u05de\u05dc\u05d0 (HTML)"
    },
    "featured_image_url": {
      "type": "string",
      "description": "\u05ea\u05de\u05d5\u05e0\u05d4 \u05e8\u05d0\u05e9\u05d9\u05ea \u05e9\u05dc \u05d4\u05de\u05d0\u05de\u05e8"
    },
    "featured_image_alt": {
      "type": "string",
      "description": "\u05d8\u05e7\u05e1\u05d8 \u05d0\u05dc\u05d8 \u05dc\u05ea\u05de\u05d5\u05e0\u05d4 \u05d4\u05e8\u05d0\u05e9\u05d9\u05ea"
    },
    "category": {
      "type": "string",
      "description": "\u05e7\u05d8\u05d2\u05d5\u05e8\u05d9\u05d4 / \u05d8\u05d0\u05d1 \u05e9\u05d0\u05dc\u05d9\u05d5 \u05e9\u05d9\u05d9\u05da \u05d4\u05de\u05d0\u05de\u05e8"
    },
    "author_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05de\u05d7\u05d1\u05e8"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "review",
        "published",
        "scheduled",
        "archived"
      ],
      "default": "draft",
      "description": "\u05e1\u05d8\u05d8\u05d5\u05e1 \u05d4\u05de\u05d0\u05de\u05e8"
    },
    "is_featured": {
      "type": "boolean",
      "default": false,
      "description": "\u05d4\u05d0\u05dd \u05dc\u05d4\u05e6\u05d9\u05d2 \u05db\u05de\u05d0\u05de\u05e8 \u05de\u05d5\u05d1\u05d9\u05dc \u05d1\u05e2\u05de\u05d5\u05d3 \u05d4\u05de\u05d0\u05de\u05e8\u05d9\u05dd"
    },
    "is_visible_on_articles": {
      "type": "boolean",
      "default": true,
      "description": "\u05d4\u05d0\u05dd \u05dc\u05d4\u05e6\u05d9\u05d2 \u05d0\u05ea \u05d4\u05de\u05d0\u05de\u05e8 \u05d1\u05e2\u05de\u05d5\u05d3 \u05d4\u05de\u05d0\u05de\u05e8\u05d9\u05dd"
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "description": "\u05e1\u05d3\u05e8 \u05d4\u05e6\u05d2\u05d4 \u05d9\u05d3\u05e0\u05d9 \u05d1\u05e2\u05de\u05d5\u05d3 \u05d4\u05de\u05d0\u05de\u05e8\u05d9\u05dd (\u05e0\u05de\u05d5\u05da = \u05e8\u05d0\u05e9\u05d5\u05df)"
    },
    "show_in_menu": {
      "type": "boolean",
      "default": false,
      "description": "\u05d4\u05d0\u05dd \u05dc\u05d4\u05e6\u05d9\u05d2 \u05d0\u05ea \u05d4\u05de\u05d0\u05de\u05e8 \u05d1\u05ea\u05e4\u05e8\u05d9\u05d8 \u05d4\u05e2\u05dc\u05d9\u05d5\u05df (\u05de\u05d0\u05de\u05e8\u05d9\u05dd \u05e0\u05d1\u05d7\u05e8\u05d9\u05dd)"
    },
    "menu_order": {
      "type": "number",
      "default": 0,
      "description": "\u05e1\u05d3\u05e8 \u05d4\u05e6\u05d2\u05d4 \u05d1\u05ea\u05e4\u05e8\u05d9\u05d8 \u05d4\u05e2\u05dc\u05d9\u05d5\u05df (\u05e0\u05de\u05d5\u05da = \u05e8\u05d0\u05e9\u05d5\u05df)"
    },
    "meta_title": {
      "type": "string",
      "description": "Meta Title \u05dc\u05d2\u05d5\u05d2\u05dc (\u05e2\u05d3 60 \u05ea\u05d5\u05d5\u05d9\u05dd)"
    },
    "meta_description": {
      "type": "string",
      "description": "Meta Description \u05dc\u05d2\u05d5\u05d2\u05dc (\u05e2\u05d3 155 \u05ea\u05d5\u05d5\u05d9\u05dd)"
    },
    "og_title": {
      "type": "string",
      "description": "Open Graph title"
    },
    "og_description": {
      "type": "string",
      "description": "Open Graph description"
    },
    "og_image": {
      "type": "string",
      "description": "Open Graph image URL"
    },
    "canonical_url": {
      "type": "string",
      "description": "Canonical URL \u05d0\u05d5\u05e4\u05e6\u05d9\u05d5\u05e0\u05dc\u05d9"
    },
    "published_at": {
      "type": "string",
      "format": "date-time",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da \u05e4\u05e8\u05e1\u05d5\u05dd"
    },
    "related_article_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u05de\u05d6\u05d4\u05d9 \u05de\u05d0\u05de\u05e8\u05d9\u05dd \u05de\u05e7\u05d5\u05e9\u05e8\u05d9\u05dd \u05dc\u05d4\u05e6\u05d2\u05d4 \u05d1'\u05db\u05ea\u05d1\u05d5\u05ea \u05e0\u05d5\u05e1\u05e4\u05d5\u05ea'"
    }
  },
  "required": [
    "title",
    "slug",
    "content"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}