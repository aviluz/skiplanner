{
  "name": "ExpenseGroup",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05e7\u05d1\u05d5\u05e6\u05d4/\u05d4\u05d8\u05d9\u05d5\u05dc"
    },
    "base_currency": {
      "type": "string",
      "default": "ILS",
      "enum": [
        "ILS",
        "USD",
        "EUR",
        "GBP"
      ],
      "description": "\u05d4\u05de\u05d8\u05d1\u05e2 \u05d4\u05d1\u05e1\u05d9\u05e1 \u05e9\u05dc \u05d4\u05e7\u05d1\u05d5\u05e6\u05d4 \u05dc\u05d7\u05d9\u05e9\u05d5\u05d1\u05d9\u05dd"
    },
    "participants": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u05e8\u05e9\u05d9\u05de\u05ea \u05e9\u05de\u05d5\u05ea \u05d4\u05de\u05e9\u05ea\u05ea\u05e4\u05d9\u05dd"
    },
    "shared_with_emails": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "email"
      },
      "description": "\u05e8\u05e9\u05d9\u05de\u05ea \u05db\u05ea\u05d5\u05d1\u05d5\u05ea \u05d4\u05de\u05d9\u05d9\u05dc \u05e9\u05dc \u05de\u05e9\u05ea\u05de\u05e9\u05d9\u05dd \u05e9\u05e0\u05d9\u05d4\u05d5\u05dc \u05d4\u05d4\u05d5\u05e6\u05d0\u05d5\u05ea \u05e9\u05d5\u05ea\u05e3 \u05d0\u05d9\u05ea\u05dd (\u05de\u05e9\u05ea\u05ea\u05e4\u05d9\u05dd \u05de\u05e9\u05d5\u05ea\u05e4\u05d9\u05dd)"
    },
    "owner_email": {
      "type": "string",
      "format": "email",
      "description": "\u05db\u05ea\u05d5\u05d1\u05ea \u05d4\u05de\u05d9\u05d9\u05dc \u05e9\u05dc \u05de\u05e0\u05d4\u05dc \u05e0\u05d9\u05d4\u05d5\u05dc \u05d4\u05d4\u05d5\u05e6\u05d0\u05d5\u05ea (\u05d4\u05d1\u05e2\u05dc\u05d9\u05dd)"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "description": {
      "type": "string",
      "description": "\u05ea\u05d9\u05d0\u05d5\u05e8 (\u05e2\u05d3 1000 \u05ea\u05d5\u05d5\u05d9\u05dd)",
      "maxLength": 1000
    }
  },
  "required": [
    "name",
    "base_currency"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.participants": "{{user.full_name}}"
        },
        {
          "data.shared_with_emails": "{{user.email}}"
        },
        {
          "data.owner_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.owner_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.owner_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}