{
  "name": "SiteSettings",
  "type": "object",
  "properties": {
    "setting_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05d4\u05d2\u05d3\u05e8\u05d4 (\u05dc\u05de\u05e9\u05dc, whatsapp_support)"
    },
    "value": {
      "type": "string",
      "description": "\u05e2\u05e8\u05da \u05d4\u05d4\u05d2\u05d3\u05e8\u05d4 (\u05dc\u05de\u05e9\u05dc, \u05e7\u05d9\u05e9\u05d5\u05e8 \u05d4\u05d5\u05d5\u05d0\u05d8\u05e1\u05d0\u05e4)"
    },
    "vip_email": {
      "type": "string",
      "description": "\u05db\u05ea\u05d5\u05d1\u05ea \u05de\u05d9\u05d9\u05dc \u05dc\u05e7\u05d1\u05dc\u05ea \u05e4\u05e0\u05d9\u05d5\u05ea VIP"
    },
    "equipment_rental_link": {
      "type": "string",
      "description": "\u05e7\u05d9\u05e9\u05d5\u05e8 \u05dc\u05d4\u05e9\u05db\u05e8\u05ea \u05e6\u05d9\u05d5\u05d3"
    },
    "terms_of_use": {
      "type": "string",
      "description": "\u05ea\u05d5\u05db\u05df \u05d3\u05e3 \u05ea\u05e0\u05d0\u05d9 \u05e9\u05d9\u05de\u05d5\u05e9"
    },
    "accessibility_statement": {
      "type": "string",
      "description": "\u05ea\u05d5\u05db\u05df \u05d4\u05e6\u05d4\u05e8\u05ea \u05e0\u05d2\u05d9\u05e9\u05d5\u05ea"
    },
    "description": {
      "type": "string",
      "description": "\u05ea\u05d9\u05d0\u05d5\u05e8 (\u05e2\u05d3 1000 \u05ea\u05d5\u05d5\u05d9\u05dd)",
      "maxLength": 1000
    }
  },
  "required": [
    "setting_name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}