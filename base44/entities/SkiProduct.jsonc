{
  "name": "SkiProduct",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05de\u05d5\u05e6\u05e8"
    },
    "category_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05e7\u05d8\u05d2\u05d5\u05e8\u05d9\u05d4 \u05de\u05d8\u05d1\u05dc\u05ea ProductCategory"
    },
    "image_url": {
      "type": "string",
      "description": "\u05ea\u05de\u05d5\u05e0\u05ea \u05d4\u05de\u05d5\u05e6\u05e8"
    },
    "price": {
      "type": "number",
      "description": "\u05de\u05d7\u05d9\u05e8 \u05d4\u05de\u05d5\u05e6\u05e8"
    },
    "link": {
      "type": "string",
      "description": "\u05e7\u05d9\u05e9\u05d5\u05e8 \u05d9\u05e9\u05d9\u05e8 \u05dc\u05e7\u05e0\u05d9\u05d9\u05d4"
    },
    "is_cheapest": {
      "type": "boolean",
      "default": false,
      "description": "\u05ea\u05d2\u05d9\u05ea: '\u05d4\u05db\u05d9 \u05d6\u05d5\u05dc \u05e9\u05d9\u05e9'"
    },
    "is_best_seller": {
      "type": "boolean",
      "default": false,
      "description": "\u05ea\u05d2\u05d9\u05ea: '\u05e8\u05d1 \u05de\u05db\u05e8'"
    },
    "editors_pick": {
      "type": "boolean",
      "default": false,
      "description": "\u05ea\u05d2\u05d9\u05ea: '\u05d1\u05d7\u05d9\u05e8\u05ea \u05d4\u05e2\u05d5\u05e8\u05db\u05d9\u05dd'"
    },
    "description": {
      "type": "string",
      "description": "\u05ea\u05d9\u05d0\u05d5\u05e8 \u05e7\u05e6\u05e8 \u05e9\u05dc \u05d4\u05de\u05d5\u05e6\u05e8"
    },
    "coupon_code": {
      "type": "string",
      "description": "\u05e7\u05d5\u05d3 \u05e7\u05d5\u05e4\u05d5\u05df"
    }
  },
  "required": [
    "name",
    "category_id",
    "price",
    "link"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}