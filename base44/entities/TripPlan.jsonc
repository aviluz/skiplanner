{
  "name": "TripPlan",
  "type": "object",
  "properties": {
    "destination_id": {
      "type": "string",
      "description": "The ID of the chosen ski destination"
    },
    "destination_name": {
      "type": "string",
      "description": "The name of the chosen ski destination"
    },
    "trip_name": {
      "type": "string",
      "description": "A user-friendly name for the trip"
    },
    "departure_date": {
      "type": "string",
      "format": "date",
      "description": "The departure date for the trip"
    },
    "return_date": {
      "type": "string",
      "format": "date",
      "description": "The return date for the trip"
    },
    "participants": {
      "type": "integer",
      "description": "Number of people going on the trip"
    },
    "budget_total": {
      "type": "number",
      "description": "Estimated total budget for the trip"
    },
    "budget_currency": {
      "type": "string",
      "enum": [
        "ILS",
        "USD",
        "EUR",
        "GBP"
      ],
      "default": "EUR",
      "description": "\u05d4\u05de\u05d8\u05d1\u05e2 \u05d4\u05e8\u05d0\u05e9\u05d9 \u05e9\u05dc \u05d4\u05ea\u05e7\u05e6\u05d9\u05d1"
    },
    "trip_status": {
      "type": "string",
      "enum": [
        "planning",
        "booked",
        "completed"
      ],
      "default": "planning"
    },
    "flexible_dates": {
      "type": "boolean",
      "default": false
    },
    "departure_month": {
      "type": "string",
      "description": "\u05d7\u05d5\u05d3\u05e9 \u05d9\u05e6\u05d9\u05d0\u05d4 \u05d1\u05de\u05e7\u05e8\u05d4 \u05e9\u05dc \u05ea\u05d0\u05e8\u05d9\u05db\u05d9\u05dd \u05d2\u05de\u05d9\u05e9\u05d9\u05dd (YYYY-MM)"
    },
    "return_month": {
      "type": "string",
      "description": "\u05d7\u05d5\u05d3\u05e9 \u05d7\u05d6\u05e8\u05d4 \u05d1\u05de\u05e7\u05e8\u05d4 \u05e9\u05dc \u05ea\u05d0\u05e8\u05d9\u05db\u05d9\u05dd \u05d2\u05de\u05d9\u05e9\u05d9\u05dd (YYYY-MM)"
    },
    "is_first_trip": {
      "type": "boolean",
      "default": false
    },
    "budget_range": {
      "type": "string",
      "enum": [
        "\u05d1\u05e1\u05d9\u05e1\u05d9",
        "\u05de\u05e4\u05e0\u05e7",
        "\u05e4\u05d0\u05e8"
      ]
    },
    "has_kosher_food": {
      "type": "boolean",
      "default": false
    },
    "arrival_airport": {
      "type": "string"
    },
    "departure_airport": {
      "type": "string"
    },
    "transport_type": {
      "type": "string",
      "enum": [
        "car",
        "transfer"
      ],
      "description": "\u05e1\u05d5\u05d2 \u05d4\u05ea\u05d7\u05d1\u05d5\u05e8\u05d4 \u05e9\u05e0\u05d1\u05d7\u05e8 - \u05e8\u05db\u05d1 \u05d0\u05d5 \u05d4\u05e1\u05e2\u05d4"
    },
    "steps_completed": {
      "type": "object",
      "properties": {
        "flights": {
          "type": "boolean",
          "default": false
        },
        "transport": {
          "type": "boolean",
          "default": false
        },
        "accommodation": {
          "type": "boolean",
          "default": false
        },
        "insurance": {
          "type": "boolean",
          "default": false
        },
        "equipment": {
          "type": "boolean",
          "default": false
        },
        "lessons": {
          "type": "boolean",
          "default": false
        },
        "ski_pass": {
          "type": "boolean",
          "default": false
        }
      },
      "description": "\u05de\u05e2\u05e7\u05d1 \u05d0\u05d7\u05e8 \u05d4\u05e9\u05dc\u05d1\u05d9\u05dd \u05e9\u05d4\u05d5\u05e9\u05dc\u05de\u05d5"
    },
    "flight_details": {
      "type": "object",
      "properties": {},
      "additionalProperties": true
    },
    "accommodation_details": {
      "type": "object",
      "properties": {},
      "additionalProperties": true
    },
    "car_rental_details": {
      "type": "object",
      "properties": {},
      "additionalProperties": true
    },
    "transfer_details": {
      "type": "object",
      "properties": {},
      "additionalProperties": true
    },
    "insurance_details": {
      "type": "object",
      "properties": {},
      "additionalProperties": true
    },
    "equipment_details": {
      "type": "object",
      "properties": {},
      "additionalProperties": true
    },
    "lessons_details": {
      "type": "object",
      "properties": {},
      "additionalProperties": true
    },
    "ski_pass_details": {
      "type": "object",
      "properties": {},
      "additionalProperties": true
    },
    "budget_items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "amount": {
            "type": "number"
          },
          "currency": {
            "type": "string",
            "enum": [
              "ILS",
              "USD",
              "EUR",
              "GBP"
            ]
          },
          "exchange_rate": {
            "type": "number",
            "default": 1
          },
          "amount_in_base": {
            "type": "number"
          },
          "source": {
            "type": "string",
            "description": "\u05de\u05e7\u05d5\u05e8 \u05d4\u05e4\u05e8\u05d9\u05d8 \u2014 'step:<stepKey>' \u05dc\u05e4\u05e8\u05d9\u05d8\u05d9\u05dd \u05e9\u05e0\u05d5\u05e6\u05e8\u05d5 \u05de\u05e9\u05dc\u05d1\u05d9 \u05d4\u05ea\u05db\u05e0\u05d5\u05df, \u05d0\u05d5 \u05e8\u05d9\u05e7/\u05d7\u05d5\u05e4\u05e9\u05d9 \u05dc\u05e4\u05e8\u05d9\u05d8\u05d9\u05dd \u05d9\u05d3\u05e0\u05d9\u05d9\u05dd"
          }
        }
      },
      "description": "\u05e4\u05e8\u05d9\u05d8\u05d9 \u05ea\u05e7\u05e6\u05d9\u05d1 \u05dc\u05de\u05d7\u05e9\u05d1\u05d5\u05df \u05d4\u05e2\u05dc\u05d5\u05d9\u05d5\u05ea"
    },
    "created_by_group": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "email"
      },
      "description": "\u05e8\u05e9\u05d9\u05de\u05ea \u05db\u05ea\u05d5\u05d1\u05d5\u05ea \u05d4\u05de\u05d9\u05d9\u05dc \u05e9\u05dc \u05de\u05e9\u05ea\u05de\u05e9\u05d9\u05dd \u05e9\u05d9\u05e9 \u05dc\u05d4\u05dd \u05d2\u05d9\u05e9\u05d4 \u05dc\u05d8\u05d9\u05d5\u05dc. \u05d4\u05e8\u05d0\u05e9\u05d5\u05df \u05d1\u05e8\u05e9\u05d9\u05de\u05d4 \u05d4\u05d5\u05d0 \u05d4\u05d1\u05e2\u05dc\u05d9\u05dd (owner)"
    },
    "shared_with": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "email"
      },
      "description": "\u05e8\u05e9\u05d9\u05de\u05ea \u05db\u05ea\u05d5\u05d1\u05d5\u05ea \u05d4\u05de\u05d9\u05d9\u05dc \u05e9\u05dc \u05de\u05e9\u05ea\u05de\u05e9\u05d9\u05dd \u05e9\u05d4\u05d8\u05d9\u05d5\u05dc \u05e9\u05d5\u05ea\u05e3 \u05d0\u05d9\u05ea\u05dd (\u05dc\u05e6\u05d5\u05e8\u05db\u05d9 UI \u05d1\u05dc\u05d1\u05d3)"
    },
    "description": {
      "type": "string",
      "description": "\u05ea\u05d9\u05d0\u05d5\u05e8 (\u05e2\u05d3 1000 \u05ea\u05d5\u05d5\u05d9\u05dd)",
      "maxLength": 1000
    }
  },
  "required": [
    "destination_id",
    "trip_name"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.created_by_group": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}