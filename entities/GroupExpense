{
  "name": "GroupExpense",
  "type": "object",
  "properties": {
    "group_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05e7\u05d1\u05d5\u05e6\u05d4"
    },
    "title": {
      "type": "string",
      "description": "\u05ea\u05d9\u05d0\u05d5\u05e8 \u05d4\u05d4\u05d5\u05e6\u05d0\u05d4"
    },
    "amount": {
      "type": "number",
      "description": "\u05e1\u05db\u05d5\u05dd \u05d4\u05d4\u05d5\u05e6\u05d0\u05d4 \u05d1\u05de\u05d8\u05d1\u05e2 \u05d4\u05de\u05e7\u05d5\u05e8\u05d9"
    },
    "currency": {
      "type": "string",
      "enum": [
        "ILS",
        "USD",
        "EUR",
        "GBP"
      ],
      "description": "\u05d4\u05de\u05d8\u05d1\u05e2 \u05e9\u05d1\u05d5 \u05e9\u05d5\u05dc\u05dd \u05d1\u05e4\u05d5\u05e2\u05dc"
    },
    "exchange_rate": {
      "type": "number",
      "default": 1,
      "description": "\u05e9\u05e2\u05e8 \u05d4\u05de\u05e8\u05d4 \u05dc\u05de\u05d8\u05d1\u05e2 \u05d4\u05d1\u05e1\u05d9\u05e1 \u05e9\u05dc \u05d4\u05e7\u05d1\u05d5\u05e6\u05d4"
    },
    "amount_in_base": {
      "type": "number",
      "description": "\u05d4\u05e1\u05db\u05d5\u05dd \u05d4\u05de\u05d7\u05d5\u05e9\u05d1 \u05d1\u05de\u05d8\u05d1\u05e2 \u05d4\u05d1\u05e1\u05d9\u05e1"
    },
    "payer_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05de\u05e9\u05dc\u05dd"
    },
    "beneficiaries": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u05e8\u05e9\u05d9\u05de\u05ea \u05d4\u05de\u05e9\u05ea\u05ea\u05e4\u05d9\u05dd \u05e9\u05e2\u05d1\u05d5\u05e8\u05dd \u05e9\u05d5\u05dc\u05de\u05d4 \u05d4\u05d4\u05d5\u05e6\u05d0\u05d4"
    },
    "category": {
      "type": "string",
      "enum": [
        "\u05db\u05dc\u05dc\u05d9",
        "\u05d0\u05d5\u05db\u05dc",
        "\u05dc\u05d9\u05e0\u05d4",
        "\u05ea\u05d7\u05d1\u05d5\u05e8\u05d4",
        "\u05d0\u05d8\u05e8\u05e7\u05e6\u05d9\u05d5\u05ea",
        "\u05e6\u05d9\u05d5\u05d3",
        "\u05d8\u05d9\u05e1\u05d5\u05ea"
      ],
      "default": "\u05db\u05dc\u05dc\u05d9"
    },
    "date": {
      "type": "string",
      "format": "date-time"
    },
    "description": {
      "type": "string",
      "description": "\u05ea\u05d9\u05d0\u05d5\u05e8 (\u05e2\u05d3 1000 \u05ea\u05d5\u05d5\u05d9\u05dd)",
      "maxLength": 1000
    }
  },
  "required": [
    "group_id",
    "title",
    "amount",
    "payer_name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.payer_name": "{{user.full_name}}"
        },
        {
          "data.beneficiaries": "{{user.full_name}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}