{
  "name": "Review",
  "type": "object",
  "properties": {
    "destination_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d9\u05e2\u05d3 \u05d4\u05e1\u05e7\u05d9 \u05d4\u05de\u05e9\u05d5\u05d9\u05da"
    },
    "user_nickname": {
      "type": "string",
      "description": "\u05db\u05d9\u05e0\u05d5\u05d9 \u05d4\u05de\u05e9\u05ea\u05de\u05e9 \u05d1\u05d6\u05de\u05df \u05d4\u05d3\u05d9\u05e8\u05d5\u05d2"
    },
    "user_ski_level": {
      "type": "string",
      "description": "\u05e8\u05de\u05ea \u05d4\u05e1\u05e7\u05d9 \u05e9\u05dc \u05d4\u05de\u05e9\u05ea\u05de\u05e9 \u05d1\u05d6\u05de\u05df \u05d4\u05d3\u05d9\u05e8\u05d5\u05d2"
    },
    "user_profile_image_url": {
      "type": "string",
      "description": "URL \u05e9\u05dc \u05ea\u05de\u05d5\u05e0\u05ea \u05e4\u05e8\u05d5\u05e4\u05d9\u05dc \u05d4\u05de\u05e9\u05ea\u05de\u05e9"
    },
    "beginner_rating": {
      "type": "number",
      "description": "\u05d3\u05d9\u05e8\u05d5\u05d2 \u05d4\u05ea\u05d0\u05de\u05d4 \u05dc\u05de\u05ea\u05d7\u05d9\u05dc\u05d9\u05dd (1-5)"
    },
    "advanced_rating": {
      "type": "number",
      "description": "\u05d3\u05d9\u05e8\u05d5\u05d2 \u05d4\u05ea\u05d0\u05de\u05d4 \u05dc\u05de\u05ea\u05e7\u05d3\u05de\u05d9\u05dd (1-5)"
    },
    "general_rating": {
      "type": "number",
      "description": "\u05d3\u05d9\u05e8\u05d5\u05d2 \u05db\u05dc\u05dc\u05d9 (1-5)"
    },
    "pros": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "3 \u05d3\u05d1\u05e8\u05d9\u05dd \u05d8\u05d5\u05d1\u05d9\u05dd"
    },
    "cons": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "3 \u05d3\u05d1\u05e8\u05d9\u05dd \u05e4\u05d7\u05d5\u05ea \u05d8\u05d5\u05d1\u05d9\u05dd"
    },
    "comment": {
      "type": "string",
      "description": "\u05ea\u05d2\u05d5\u05d1\u05d4 \u05d7\u05d5\u05e4\u05e9\u05d9\u05ea"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "default": "pending",
      "description": "\u05e1\u05d8\u05d8\u05d5\u05e1 \u05d0\u05d9\u05e9\u05d5\u05e8 \u05d4\u05d1\u05d9\u05e7\u05d5\u05e8\u05ea"
    },
    "description": {
      "type": "string",
      "description": "\u05ea\u05d9\u05d0\u05d5\u05e8 \u05e0\u05d5\u05e1\u05e3 (\u05e2\u05d3 1000 \u05ea\u05d5\u05d5\u05d9\u05dd)",
      "maxLength": 1000
    }
  },
  "required": [
    "destination_id",
    "general_rating"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.status": "approved"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}